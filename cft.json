{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "ServiceNow Cloud Call Center Default Stack",
  "Parameters" : {
    "LambdaS3BucketName" : {
      "Type" : "String",
      "Default" : "",
      "Description" : "S3 Bucket Name where Lambda.zip is uploaded"
    },
    "LambdaFileKey" : {
      "Type" : "String",
      "Default" : "",
      "Description" : "Provide S3 file Key for Lambda Zip artifact"
    },
    "CallRecordingBucketName" : {
      "Type" : "String",
      "Default" : "",
      "Description" : "Provide the call recording Bucket Name"
    }
  },
  "Resources": {
    "snTQVENRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Allow",
            "Principal": {
              "Service": "lambda.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }]
        }
      }
    },
    "snTQVENPolicy":{
      "Type": "AWS::IAM::Policy",
      "DependsOn": ["snTQVENLambdaLogGroup", "snTQVENKinesisStream"],
      "Properties": {
        "PolicyName": "snTQVENLambdaPolicy",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "InlinePolicy0",
              "Effect": "Allow",
              "Action": [
                "kms:Decrypt",
                "kms:Encrypt",
                "kinesis:ListStreams"
              ],
              "Resource": "*"
            },
            {
              "Sid": "InlinePolicy1",
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents",
                "ssm:PutParameter",
                "ssm:GetParameter",
                "ssm:GetParametersByPath"
              ],
              "Resource": [
                { "Fn::Sub": ["arn:aws:s3:::${callBucket}/*", { "callBucket": {"Ref" : "CallRecordingBucketName" }}]},
                { "Fn::Sub": ["arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:${loggroup}", {"loggroup": {"Ref": "snTQVENLambdaLogGroup"}}]},
                { "Fn::Sub": ["arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:${loggroup}:log-stream:*", {"loggroup": {"Ref": "snTQVENLambdaLogGroup"}}]},
                { "Fn::Sub": ["arn:aws:ssm:${AWS::Region}:${AWS::AccountId}:parameter/${defaultParam}", {"defaultParam": "com.servicenow.cti/a4696d4fff3db658c80bf8e4fc4fd901/TQVEN/default/*"}]},
                { "Fn::Sub": ["arn:aws:ssm:${AWS::Region}:${AWS::AccountId}:parameter/${defaultParam}", {"defaultParam": "com.servicenow.cti/a4696d4fff3db658c80bf8e4fc4fd901/TQVEN/default"}]}
              ]
            },
            {
              "Sid": "InlinePolicy2",
              "Effect": "Allow",
              "Action": [
                "kinesis:GetRecords",
                "kinesis:GetShardIterator",
                "kinesis:DescribeStream"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": ["snTQVENKinesisStream", "Arn"]
                }
              ]
            },
            {
              "Sid": "InlinePolicy3",
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": ["snTQVENContactInteractionMapping", "Arn"]
                }
              ]
            }
          ]
        },
        "Roles": [
          {
            "Ref": "snTQVENRole"
          }
        ]
      }
    },
    "snTQVENLambda": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": ["snTQVENRole", "snTQVENContactInteractionMapping"],
      "Properties": {
        "Handler": "index.handler",
        "FunctionName": "snTQVENLambda",
        "Role": {
          "Fn::GetAtt": ["snTQVENRole", "Arn"]
        },
        "Code": {
          "S3Bucket": { "Ref" : "LambdaS3BucketName" },
          "S3Key": { "Ref" : "LambdaFileKey" }
        },
        "Layers": [
          { "Fn::Sub": "arn:aws:lambda:${AWS::Region}:094274105915:layer:AWSLambdaPowertoolsTypeScriptV2:47" }
        ],
        "Environment": {
          "Variables": {
            "ssm_configuration_path": "/com.servicenow.cti/a4696d4fff3db658c80bf8e4fc4fd901/TQVEN/default",
            "provider_id": "c4b12aa6e700001034b36584c2f6a9bc",
            "dynamodb_table": "snTQVENContactInteractionMapping",
            "call_context_api_url": "",
            "now_instance_host_name": "ven08793.service-now.com",
            "now_instance_name": "ven08793"
          }
        },
        "Runtime": "nodejs22.x",
        "Timeout": "30"
      }
    },
    "snTQVENLambdaLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Join": ["", ["/aws/lambda/", {
            "Ref": "snTQVENLambda"
          }]]
        },
        "RetentionInDays": 30
      }
    },
    "snTQVENKinesisStream" : {
      "Type" : "AWS::Kinesis::Stream",
      "Properties" : {
        "Name":"snTQVENKinesisStream",
        "ShardCount" : "1"
      }
    },
    "snTQVENLambdaLexPermissions":{
      "Type" : "AWS::Lambda::Permission",
      "Properties" : {
        "Action" : "lambda:InvokeFunction",
        "FunctionName" : {
          "Fn::GetAtt": ["snTQVENLambda", "Arn"]
        },
        "Principal" : "lex.amazonaws.com",
        "SourceArn" : { "Fn::Sub": "arn:aws:lex:${AWS::Region}:${AWS::AccountId}:intent:*" }
      }
    },
    "snTQVENDefaultConfigurationProfile": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Description": "The ServiceNow settings for the CTI REST endpoint.",
        "Name": "/com.servicenow.cti/a4696d4fff3db658c80bf8e4fc4fd901/TQVEN/default",
        "Type": "String",
        "Value": "{\r\n    required: {\r\n        host: {\r\n            description: \"The ServiceNow host that connect proxy will talk to\"\r\n            value: \"instance.service-now.com\",\r\n        },\r\n        service_account_user: {\r\n            description: \"Service account username for CTI REST Endpoint\"\r\n        },\r\n        service_account_password: {\r\n            description: \"Service account password for CTI REST Endpoint\"\r\n        }\r\n    },\r\n    optional: {\r\n        provider_id: {\r\n            description: \"CTI REST endpoint provider id\",\r\n            value: \"c4b12aa6e700001034b36584c2f6a9bc\"\r\n        }\r\n    }\r\n}"
      }
    },
    "snTQVENCtiRestHost": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Description": "The ServiceNow instance that contains your CTI REST endpoint",
        "Name": "/com.servicenow.cti/a4696d4fff3db658c80bf8e4fc4fd901/TQVEN/default/host",
        "Type": "String",
        "Value": "ven08793.service-now.com"
      }
    },
    "snTQVENEventSourceMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "DependsOn":["snTQVENLambda", "snTQVENPolicy"],
      "Properties": {
        "EventSourceArn": {
          "Fn::Sub": ["arn:aws:kinesis:${AWS::Region}:${AWS::AccountId}:stream/${kinesisstream}",{"kinesisstream": {"Ref": "snTQVENKinesisStream"}}]
        },
        "FunctionName": {
          "Fn::GetAtt": ["snTQVENLambda","Arn"]
        },
        "StartingPosition": "TRIM_HORIZON"
      }
    },
    "snTQVENContactInteractionMapping": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "snTQVENContactInteractionMapping",
        "KeySchema": [
          {
            "AttributeName": "contactId",
            "KeyType": "HASH"
          }
        ],
        "AttributeDefinitions": [
          {
            "AttributeName": "contactId",
            "AttributeType": "S"
          }
        ],
        "BillingMode": "PAY_PER_REQUEST"
      }
    },
    "snTQVENDisconnectedEventBridgeRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": "snTQVENDisconnectedEventBridgeRule",
        "EventPattern": {
          "source": ["aws.connect"],
          "detail-type": ["Amazon Connect Contact Event"],
          "detail": {
            "instanceArn": [{ "Fn::Sub": "arn:aws:connect:us-west-2:807816545386:instance/73bf71d7-bcbe-41dc-82a4-a73622a53299" }],
            "eventType": ["DISCONNECTED"],
            "initiationMethod": ["INBOUND", "OUTBOUND"]
          }
        },
        "State": "ENABLED",
        "Description": "Triggers Lambda on Amazon Connect DISCONNECTED contact events for inbound and outbound calls",
        "EventBusName": "default",
        "Targets": [{
          "Id": "DisconnectedEventLambdaTarget",
          "Arn": {
            "Fn::GetAtt": ["snTQVENLambda", "Arn"]
          },
          "RetryPolicy": {
            "MaximumRetryAttempts": 0
          }
        }]
      }
    },
    "snTQVENLambdaEventBridgePermissions": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName" : {
          "Fn::GetAtt": ["snTQVENLambda", "Arn"]
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "events.amazonaws.com",
        "SourceArn": { "Fn::GetAtt": ["snTQVENDisconnectedEventBridgeRule", "Arn"] }
      }
    }
  }
}
